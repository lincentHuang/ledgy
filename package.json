{
  "name": "ai-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "web": "next dev -p 3000",
    "build": "next build",
    "build:export": "NEXT_EXPORT=true next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "deploy": "yarn build:export && npx -y firebase-tools@latest deploy --only hosting",
    "cap:sync": "yarn build:export && export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=\"/opt/homebrew/bin:$PATH\" && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.4.0"
  }
}
