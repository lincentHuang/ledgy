rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    // 成員判定：memberIds 內，或是組長 (相容尚未補上 memberIds 的舊群組)
    function isMemberData(data) {
      return signedIn()
        && (request.auth.uid in data.get('memberIds', []) || data.get('ownerId', '') == request.auth.uid);
    }

    function isMember(hid) {
      return isMemberData(get(householdPath(hid)).data);
    }

    function isMemberAfter(hid) {
      return isMemberData(getAfter(householdPath(hid)).data);
    }

    function myEmail() {
      return request.auth.token.get('email', '');
    }

    function isInvitee(data) {
      return signedIn() && myEmail() != '' && myEmail() in data.get('pendingInviteeEmails', []);
    }

    // 被邀請者回覆邀請：只能把自己加入成員、消掉自己的邀請，不能動其他欄位
    function respondsToOwnInvitation() {
      let before = resource.data.get('memberIds', []).toSet();
      let after = request.resource.data.get('memberIds', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).size() == 0
        && !(myEmail() in request.resource.data.get('pendingInviteeEmails', []))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberIds', 'pendingInvitations', 'pendingInviteeEmails', 'updatedAt']);
    }

    // 個人資料與個人帳目、發票、學習規則：只有本人
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /households/{hid} {
      // 直接比對欄位 (不用 get 預設值)，讓 memberIds / ownerId / pendingInviteeEmails 查詢能通過規則檢查
      allow read: if signedIn()
        && (request.auth.uid in resource.data.memberIds
            || resource.data.ownerId == request.auth.uid
            || myEmail() in resource.data.pendingInviteeEmails);
      allow create: if signedIn() && request.auth.uid in request.resource.data.get('memberIds', []);
      allow update: if (isMemberData(resource.data) && request.resource.data.ownerId == resource.data.ownerId)
        || (isInvitee(resource.data) && respondsToOwnInvitation());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /transactions/{txId} {
        allow read, write: if isMember(hid);
      }

      // 加入申請：文件 ID 即申請者 uid，申請者只能建立/查看/撤回自己的申請，成員負責審核
      match /joinRequests/{applicantId} {
        allow read, delete: if signedIn() && (request.auth.uid == applicantId || isMember(hid));
        allow create: if signedIn()
          && request.auth.uid == applicantId
          && request.resource.data.applicantUserId == applicantId
          && request.resource.data.householdId == hid
          && request.resource.data.status == 'pending';
      }
    }

    // 邀請碼 → 群組對照：知道代碼才能 get，不開放列舉
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if isMemberAfter(request.resource.data.householdId);
      allow update: if isMember(resource.data.householdId)
        && request.resource.data.householdId == resource.data.householdId;
      allow delete: if isMember(resource.data.householdId);
    }

    // 設定頁的連線測試
    match /_system/connection_test {
      allow read, write: if signedIn();
    }
  }
}
