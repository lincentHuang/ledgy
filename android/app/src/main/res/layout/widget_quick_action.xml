<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:padding="8dp"
    android:gravity="center">

    <!-- 🎙️ 語音記帳按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="語音記帳"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 📷 掃描發票按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_scan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="掃發票"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ➕ 快速新增按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_add"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="記一筆"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
