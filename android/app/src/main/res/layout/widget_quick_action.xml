<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:padding="8dp"
    android:gravity="center">

    <!-- 🎙️ 語音記帳按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_voice"
            android:contentDescription="語音記帳" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="語音記帳"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- 📷 掃描發票按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_scan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="4dp"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_scan"
            android:contentDescription="掃發票" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="掃發票"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- ✍️ 記一筆按鈕 -->
    <LinearLayout
        android:id="@+id/widget_btn_add"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_pen"
            android:contentDescription="記一筆" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="記一筆"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
